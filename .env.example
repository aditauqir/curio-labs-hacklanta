# Copy to .env.local for local development. Never commit real values.
# On the Vultr server, the same variables go in /var/www/curiolabs/.env.local
# All keys are server-side only. Never prefix them with NEXT_PUBLIC_.

# Gemini: the creative director's design edits (the "brain")
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest
# Optional live design research. Uses Gemini 2.5 Flash-Lite + Google Search.
# The free tier allows up to 500 grounded requests per day (shared quota).
# Keep this at 0 to avoid Search grounding requests; set to 1 only when wanted.
GEMINI_ENABLE_SEARCH=0
# GEMINI_SEARCH_MODEL=gemini-2.5-flash-lite
# Gemini's managed Search tool chooses queries; this prompt guard caps the
# requested research pass at five targeted queries.
GEMINI_SEARCH_MAX_QUERIES=5

# Optional server-only HTTP endpoint for the Curio Python raster renderer.
# CURIO_PYTHON_PIPELINE_URL=

# ElevenLabs: spoken replies (the "voice"), and backup speech-to-text
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Whisper: offline speech-to-text for the microphone. No key needed.
# Install and start it with: bash scripts/whisper-setup.sh && bash scripts/whisper-run.sh
# WHISPER_URL=http://127.0.0.1:8178
# WHISPER_ENABLED=true

# Creative pipeline: deterministic mock provider for tests and offline work.
# Set to 1 ONLY in development or CI. It makes the pipeline answer without a
# model; every response is labelled provider "mock" and must never be shown as
# real AI output. Leave empty in production.
# CURIO_AI_MOCK=

# Timescale/PostgreSQL persistence. Keep the real connection string server-side.
DATABASE_URL=
# Optional server-only token for loading shared font/media assets into the library.
# LIBRARY_WRITE_TOKEN=
