# Copy to .env.local for local development. Never commit real values.
# On the Vultr server, the same variables go in /var/www/curiolabs/.env.local
# All keys are server-side only. Never prefix them with NEXT_PUBLIC_.

# Gemini: the creative director's design edits (the "brain")
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest

# ElevenLabs: spoken replies (the "voice"), and backup speech-to-text
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Whisper: offline speech-to-text for the microphone. No key needed.
# Install and start it with: bash scripts/whisper-setup.sh && bash scripts/whisper-run.sh
# WHISPER_URL=http://127.0.0.1:8178
# WHISPER_ENABLED=true
