{
  "name": "curio-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "npm run check:secrets && npm run lint && npm run typecheck",
    "test:e2e": "playwright test",
    "test:unit": "node --test \"scripts/**/*.test.mjs\" \"lib/**/*.test.mjs\"",
    "branch": "node scripts/new-branch.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "postgres": "^3.4.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
